NODE_ENV="development"
NODE_VERSION="24.22.1"

REDIS_URL="redis://127.0.0.1:6379"
RATE_LIMIT_SETTINGS="5"             # 5/min/utilisateur
RATE_LIMIT_STORY_EDITION="250"      # 250/min/utilisateur
RATE_LIMIT_STORY_CREATION="10"      # 10/h/utilisateur
RATE_LIMIT_BOOKMARK="60"            # 60/min/utilisateur
RATE_LIMIT_LOGOUT="10"              # 10/min/utilisateur

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# OAuth (providers activés dans supabase/config.toml, secrets jamais commités)
# Callback à déclarer chez Discord/Google : http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# URL publique du site (redirectTo OAuth en prod)
SITE_URL="http://localhost:3000"