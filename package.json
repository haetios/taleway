{
  "name": "taleway.co",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",

    "db:start": "supabase start",
    "db:gen": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:stop": "supabase stop",

    "redis:up": "docker compose up -d redis",
    "redis:stop": "docker compose down redis",

    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "supabase stop --no-backup; supabase start; drizzle-kit push",

    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
